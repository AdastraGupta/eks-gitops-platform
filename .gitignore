# ─── Terraform ─────────────────────────────────────────────────────────────────
# Local .terraform directories
**/.terraform/

# `.tfstate` files contain sensitive state data (passwords, IP addresses, tokens)
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Terraform execution plans contain sensitive state data in binary format
*.tfplan
*.plan

# State lock files
.terraform.tfstate.lock.info

# Terraform variable definitions containing secrets
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI Configuration
.terraformrc
terraform.rc

# ─── Secrets, Keys & Environment Files ─────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.csr
*.id_rsa
id_rsa*
credentials.json
aws-credentials

# ─── Kubernetes / Helm ────────────────────────────────────────────────────────
kubeconfig
*.kubeconfig
kubeconfig.yaml
kubeconfig.*.yaml
.kube/

# Helm package artifacts & downloaded subcharts
*.tgz
charts/*/charts/
charts/*/*.tgz
.helm/

